<?xml version='1.0' encoding='UTF-8'?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd" identifier="id-rost-crm-model">
  <name xml:lang="ru">ИТ Школа Ростелекома — CRM (Архитектурная модель ArchiMate 3.1)</name>
  <documentation xml:lang="ru">Комплексная архитектурная модель системы «ИТ Школа Ростелекома — CRM» (rost_crm), разработанная в соответствии со стандартом The Open Group ArchiMate 3.1 Model Exchange File. Охватывает Бизнес-слой (акторы, роли, процессы воронки партнерств, объекты), Слой приложений (SPA, FastAPI ядро, движки воронки, отчетов, файлов, интеграций, шина Keycloak, LMS Zion, Сайт Laravel) и Технологический слой (Linux, Docker, PostgreSQL 16, Python 3.12, Nginx, сетевые периметры DMZ/LAN).</documentation>
  <elements>
    <element identifier="id-elem-ba-manager" xsi:type="BusinessActor">
      <name xml:lang="ru">Менеджер партнерств</name>
      <documentation xml:lang="ru">Сотрудник ПАО «Ростелеком», ведущий взаимодействия с образовательными организациями.</documentation>
    </element>
    <element identifier="id-elem-ba-supervisor" xsi:type="BusinessActor">
      <name xml:lang="ru">Руководитель направления</name>
      <documentation xml:lang="ru">Куратор региональной команды менеджеров, контролирующий воронку партнерств и аналитику.</documentation>
    </element>
    <element identifier="id-elem-ba-admin" xsi:type="BusinessActor">
      <name xml:lang="ru">Системный администратор</name>
      <documentation xml:lang="ru">Администратор платформы, управляющий пользователями, миграциями процессов и сверкой заявок.</documentation>
    </element>
    <element identifier="id-elem-ba-unirep" xsi:type="BusinessActor">
      <name xml:lang="ru">Представитель образовательной организации</name>
      <documentation xml:lang="ru">Контактное лицо вуза/колледжа: ректор, декан, преподаватель.</documentation>
    </element>
    <element identifier="id-elem-br-operator" xsi:type="BusinessRole">
      <name xml:lang="ru">Оператор воронки партнерств</name>
      <documentation xml:lang="ru">Роль ведения карточек взаимодействия, согласования и фиксации этапов.</documentation>
    </element>
    <element identifier="id-elem-br-curator" xsi:type="BusinessRole">
      <name xml:lang="ru">Куратор регионального портфеля</name>
      <documentation xml:lang="ru">Роль распределения вузов и мониторинга аналитики команды.</documentation>
    </element>
    <element identifier="id-elem-br-secadmin" xsi:type="BusinessRole">
      <name xml:lang="ru">Администратор безопасности и конфигурации</name>
      <documentation xml:lang="ru">Роль управления каталогами, миграции версий workflow и разрешения заявок.</documentation>
    </element>
    <element identifier="id-elem-bc-partnership" xsi:type="BusinessCollaboration">
      <name xml:lang="ru">Сотрудничество в проекте «ИТ Школа»</name>
      <documentation xml:lang="ru">Совместная деятельность Ростелекома и образовательных организаций.</documentation>
    </element>
    <element identifier="id-elem-bp-initiation" xsi:type="BusinessProcess">
      <name xml:lang="ru">Инициация партнерства</name>
      <documentation xml:lang="ru">Этапы: 1. Поиск контактов -&gt; 2. Уточнение потребности -&gt; 3. Встреча с вузом.</documentation>
    </element>
    <element identifier="id-elem-bp-contracting" xsi:type="BusinessProcess">
      <name xml:lang="ru">Договорная кампания</name>
      <documentation xml:lang="ru">Этапы: 4. Обмен документами -&gt; 5. Корректировка -&gt; 6. Подписание документов.</documentation>
    </element>
    <element identifier="id-elem-bp-transfer" xsi:type="BusinessProcess">
      <name xml:lang="ru">Внедрение ПО и передача материалов</name>
      <documentation xml:lang="ru">Этапы: 7. Передача материалов -&gt; 8. Сопровождение -&gt; 9. Обучение преподавателей.</documentation>
    </element>
    <element identifier="id-elem-bp-study" xsi:type="BusinessProcess">
      <name xml:lang="ru">Учебный процесс и сопровождение</name>
      <documentation xml:lang="ru">Этапы: 10. Актуализация -&gt; 11. Ведение занятий -&gt; 12. Обновление материалов -&gt; 13. Повышение квалификации.</documentation>
    </element>
    <element identifier="id-elem-bp-analytics" xsi:type="BusinessProcess">
      <name xml:lang="ru">Формирование управленческой аналитики</name>
      <documentation xml:lang="ru">Построение срезов портфеля на дату (snapshot), динамики активности (activity) и привлечения (created).</documentation>
    </element>
    <element identifier="id-elem-bo-interaction" xsi:type="BusinessObject">
      <name xml:lang="ru">Карточка взаимодействия</name>
      <documentation xml:lang="ru">Центральная бизнес-сущность сотрудничества по образовательной программе.</documentation>
    </element>
    <element identifier="id-elem-bo-contract" xsi:type="BusinessObject">
      <name xml:lang="ru">Договор о сотрудничестве</name>
      <documentation xml:lang="ru">Двусторонний юридический договор между Ростелекомом и вузом.</documentation>
    </element>
    <element identifier="id-elem-bo-license" xsi:type="BusinessObject">
      <name xml:lang="ru">Лицензия на ИТ-продукт</name>
      <documentation xml:lang="ru">Лицензионное соглашение на программные продукты Ростелекома.</documentation>
    </element>
    <element identifier="id-elem-bo-contact" xsi:type="BusinessObject">
      <name xml:lang="ru">Контактные данные представителя</name>
      <documentation xml:lang="ru">Персональные данные представителя образовательной организации (ФИО, телефон, email).</documentation>
    </element>
    <element identifier="id-elem-bo-report" xsi:type="BusinessObject">
      <name xml:lang="ru">Аналитический отчет</name>
      <documentation xml:lang="ru">Сводные отчетные материалы в форматах XLSX, PDF и JSON.</documentation>
    </element>
    <element identifier="id-elem-ac-crm" xsi:type="ApplicationComponent">
      <name xml:lang="ru">ИТ Школа Ростелекома — CRM</name>
      <documentation xml:lang="ru">Централизованная система управления взаимодействиями с вузами.</documentation>
    </element>
    <element identifier="id-elem-ac-frontend" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Single-Page Application (React UI)</name>
      <documentation xml:lang="ru">Клиентское веб-приложение в дизайн-системе Rostelecom Gen2 Light (React 18, Vite). In-memory JWT.</documentation>
    </element>
    <element identifier="id-elem-ac-backend" xsi:type="ApplicationComponent">
      <name xml:lang="ru">FastAPI Backend Core API</name>
      <documentation xml:lang="ru">Высокопроизводительное асинхронное ядро бизнес-логики и REST API (Python 3.12+).</documentation>
    </element>
    <element identifier="id-elem-ac-workflow" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Workflow Engine &amp; Migrator</name>
      <documentation xml:lang="ru">Движок управления 15 статусами воронки, валидации переходов и транзакционной миграции v1 -&gt; v2.</documentation>
    </element>
    <element identifier="id-elem-ac-reports" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Analytical Reports Engine</name>
      <documentation xml:lang="ru">Модуль расчета срезов и бинарной генерации XLSX (OOXML) и векторных PDF с символикой Ростелекома.</documentation>
    </element>
    <element identifier="id-elem-ac-files" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Secure File Service</name>
      <documentation xml:lang="ru">Изолированное хранилище 10 форматов ТЗ с валидацией magic bytes, защитой от Path Traversal и SHA-256.</documentation>
    </element>
    <element identifier="id-elem-ac-import" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Two-Phase Import Wizard</name>
      <documentation xml:lang="ru">Двухфазный мастер пакетного импорта каталогов (Dry-Run Preview и транзакционный Commit).</documentation>
    </element>
    <element identifier="id-elem-ac-integrations" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Integrations Gateway &amp; Reconciliation Inbox</name>
      <documentation xml:lang="ru">Шлюз адаптеров LMS Zion и Сайта Laravel с очередью сверки коллизий заявок.</documentation>
    </element>
    <element identifier="id-elem-ac-audit" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Audit &amp; Event Sourcing Store</name>
      <documentation xml:lang="ru">Неизменяемое хранилище событий InteractionEvent с монотонным sequence и полными снимками состояния.</documentation>
    </element>
    <element identifier="id-elem-ac-keycloak" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Keycloak Identity Provider</name>
      <documentation xml:lang="ru">Корпоративный сервер федеративной аутентификации (OIDC PKCE S256).</documentation>
    </element>
    <element identifier="id-elem-ac-lms" xsi:type="ApplicationComponent">
      <name xml:lang="ru">LMS Zion (rtkb.zion-lms.ru)</name>
      <documentation xml:lang="ru">Внешняя образовательная платформа (активные потоки, зачисленные студенты).</documentation>
    </element>
    <element identifier="id-elem-ac-website" xsi:type="ApplicationComponent">
      <name xml:lang="ru">Внешний сайт заявок (Laravel)</name>
      <documentation xml:lang="ru">Публичный портал приема входящих заявок образовательных организаций.</documentation>
    </element>
    <element identifier="id-elem-ai-rest" xsi:type="ApplicationInterface">
      <name xml:lang="ru">REST API v1 Interface (/api/v1/)</name>
      <documentation xml:lang="ru">Стандартизированный программный интерфейс JSON REST API с CAS и Idempotency-Key.</documentation>
    </element>
    <element identifier="id-elem-ai-oidc" xsi:type="ApplicationInterface">
      <name xml:lang="ru">Keycloak OIDC PKCE S256 Interface</name>
      <documentation xml:lang="ru">Интерфейс авторизации OAuth2/OIDC.</documentation>
    </element>
    <element identifier="id-elem-ai-lms" xsi:type="ApplicationInterface">
      <name xml:lang="ru">LMS Adapter Interface (DTO v1.0)</name>
      <documentation xml:lang="ru">Нормализованный интеграционный конверт сбора метрик.</documentation>
    </element>
    <element identifier="id-elem-ai-web" xsi:type="ApplicationInterface">
      <name xml:lang="ru">Website Webhook Interface (DTO v1.0)</name>
      <documentation xml:lang="ru">Интерфейс приема пакетов заявок с внешнего сайта.</documentation>
    </element>
    <element identifier="id-elem-ai-gui" xsi:type="ApplicationInterface">
      <name xml:lang="ru">Web GUI Interface</name>
      <documentation xml:lang="ru">Пользовательский интерфейс в веб-браузере.</documentation>
    </element>
    <element identifier="id-elem-as-interaction" xsi:type="ApplicationService">
      <name xml:lang="ru">Сервис управления взаимодействиями</name>
      <documentation xml:lang="ru">API CRUD карточек, переходы статусов, CAS-обновление ревизий.</documentation>
    </element>
    <element identifier="id-elem-as-auth" xsi:type="ApplicationService">
      <name xml:lang="ru">Сервис контроля доступа и Scope 152-ФЗ</name>
      <documentation xml:lang="ru">Проверка подписи JWT, расчет scope_clause, скрытие записей через 404 Not Found.</documentation>
    </element>
    <element identifier="id-elem-as-reports" xsi:type="ApplicationService">
      <name xml:lang="ru">Сервис аналитических отчетов</name>
      <documentation xml:lang="ru">Построение срезов портфеля, генерация XLSX и векторных PDF.</documentation>
    </element>
    <element identifier="id-elem-as-files" xsi:type="ApplicationService">
      <name xml:lang="ru">Сервис безопасного хранения файлов</name>
      <documentation xml:lang="ru">Фильтрация расширений, проверка magic bytes, потоковая отдача FileResponse.</documentation>
    </element>
    <element identifier="id-elem-as-sync" xsi:type="ApplicationService">
      <name xml:lang="ru">Сервис синхронизации и сверки заявок</name>
      <documentation xml:lang="ru">Дедупликация DTO v1.0 и ручное сопоставление вузов.</documentation>
    </element>
    <element identifier="id-elem-do-interaction" xsi:type="DataObject">
      <name xml:lang="ru">Сущность Interaction</name>
      <documentation xml:lang="ru">Модель данных карточки партнерства в реляционной БД.</documentation>
    </element>
    <element identifier="id-elem-do-event" xsi:type="DataObject">
      <name xml:lang="ru">Сущность InteractionEvent</name>
      <documentation xml:lang="ru">Модель темпорального события с sequence и snapshot.</documentation>
    </element>
    <element identifier="id-elem-do-attachment" xsi:type="DataObject">
      <name xml:lang="ru">Сущность Attachment</name>
      <documentation xml:lang="ru">Модель метаданных файла с контрольной суммой SHA-256.</documentation>
    </element>
    <element identifier="id-elem-do-inbox" xsi:type="DataObject">
      <name xml:lang="ru">Сущность IntegrationInbox</name>
      <documentation xml:lang="ru">Модель очереди входящих заявок с композитным ключом дедупликации.</documentation>
    </element>
    <element identifier="id-elem-do-metric" xsi:type="DataObject">
      <name xml:lang="ru">Сущность LearningMetric</name>
      <documentation xml:lang="ru">Модель образовательных показателей востребованности программ.</documentation>
    </element>
    <element identifier="id-elem-do-token" xsi:type="DataObject">
      <name xml:lang="ru">In-Memory JWT Access Token</name>
      <documentation xml:lang="ru">Аутентификационный токен, удерживаемый в оперативной памяти JavaScript.</documentation>
    </element>
    <element identifier="id-elem-node-app" xsi:type="Node">
      <name xml:lang="ru">Сервер приложений CRM</name>
      <documentation xml:lang="ru">Выделенный вычислительный узел хостинга бэкенда и веб-сервера.</documentation>
    </element>
    <element identifier="id-elem-node-db" xsi:type="Node">
      <name xml:lang="ru">Сервер баз данных</name>
      <documentation xml:lang="ru">Выделенный сервер реляционной СУБД.</documentation>
    </element>
    <element identifier="id-elem-dev-client" xsi:type="Device">
      <name xml:lang="ru">Клиентское рабочее место сотрудника</name>
      <documentation xml:lang="ru">Рабочая станция / ноутбук пользователя с веб-браузером.</documentation>
    </element>
    <element identifier="id-elem-ss-linux" xsi:type="SystemSoftware">
      <name xml:lang="ru">Linux OS (Ubuntu 22.04 LTS / RHEL 9)</name>
      <documentation xml:lang="ru">Базовая серверная операционная система с настроенными политиками безопасности.</documentation>
    </element>
    <element identifier="id-elem-ss-docker" xsi:type="SystemSoftware">
      <name xml:lang="ru">Docker Engine &amp; Compose</name>
      <documentation xml:lang="ru">Среда контейнеризации прикладных сервисов.</documentation>
    </element>
    <element identifier="id-elem-ss-python" xsi:type="SystemSoftware">
      <name xml:lang="ru">Python 3.12+ Runtime</name>
      <documentation xml:lang="ru">Среда исполнения бэкенда с AnyIO и Uvicorn.</documentation>
    </element>
    <element identifier="id-elem-ss-postgres" xsi:type="SystemSoftware">
      <name xml:lang="ru">PostgreSQL 16 RDBMS</name>
      <documentation xml:lang="ru">Транзакционная реляционная СУБД с поддержкой ACID.</documentation>
    </element>
    <element identifier="id-elem-ss-nginx" xsi:type="SystemSoftware">
      <name xml:lang="ru">Nginx Web Server / Reverse Proxy</name>
      <documentation xml:lang="ru">Веб-сервер терминации TLS 1.3, статики SPA и проксирования.</documentation>
    </element>
    <element identifier="id-elem-ss-browser" xsi:type="SystemSoftware">
      <name xml:lang="ru">Modern Web Browser</name>
      <documentation xml:lang="ru">Браузер с поддержкой стандартов HTML5, ES2022, Web Crypto API.</documentation>
    </element>
    <element identifier="id-elem-ss-keycloak" xsi:type="SystemSoftware">
      <name xml:lang="ru">Keycloak 24+ Server</name>
      <documentation xml:lang="ru">Сервер управления доступом и аутентификацией.</documentation>
    </element>
    <element identifier="id-elem-net-corp" xsi:type="CommunicationNetwork">
      <name xml:lang="ru">Корпоративная сеть ПАО «Ростелеком»</name>
      <documentation xml:lang="ru">Защищенный внутренний периметр LAN / IPsec VPN.</documentation>
    </element>
    <element identifier="id-elem-net-dmz" xsi:type="CommunicationNetwork">
      <name xml:lang="ru">Периметр безопасности DMZ</name>
      <documentation xml:lang="ru">Демилитаризованная зона внешних сетевых интерфейсов.</documentation>
    </element>
    <element identifier="id-elem-net-internal" xsi:type="CommunicationNetwork">
      <name xml:lang="ru">Изолированная сеть контейнеров</name>
      <documentation xml:lang="ru">Внутренняя сеть взаимодействия бэкенда и СУБД.</documentation>
    </element>
    <element identifier="id-elem-art-spa" xsi:type="Artifact">
      <name xml:lang="ru">Дистрибутив React SPA (Static Bundle)</name>
      <documentation xml:lang="ru">Скомпилированные статические файлы клиентского интерфейса.</documentation>
    </element>
    <element identifier="id-elem-art-backend" xsi:type="Artifact">
      <name xml:lang="ru">Пакет Backend API Core</name>
      <documentation xml:lang="ru">Исполняемый дистрибутив FastAPI приложения.</documentation>
    </element>
    <element identifier="id-elem-art-storage" xsi:type="Artifact">
      <name xml:lang="ru">Том хранилища (storage/attachments/)</name>
      <documentation xml:lang="ru">Изолированный том постоянного хранения проверенных файлов.</documentation>
    </element>
    <element identifier="id-elem-art-dbdata" xsi:type="Artifact">
      <name xml:lang="ru">Файлы данных PostgreSQL</name>
      <documentation xml:lang="ru">Физические файлы табличных пространств СУБД.</documentation>
    </element>
  </elements>
  <relationships>
    <relationship identifier="id-rel-01" source="id-elem-ba-manager" target="id-elem-br-operator" xsi:type="Assignment">
      <name xml:lang="ru">Назначение</name>
      <documentation xml:lang="ru">Менеджер исполняет роль оператора воронки.</documentation>
    </relationship>
    <relationship identifier="id-rel-02" source="id-elem-ba-supervisor" target="id-elem-br-curator" xsi:type="Assignment">
      <name xml:lang="ru">Назначение</name>
      <documentation xml:lang="ru">Руководитель исполняет роль куратора портфеля.</documentation>
    </relationship>
    <relationship identifier="id-rel-03" source="id-elem-ba-admin" target="id-elem-br-secadmin" xsi:type="Assignment">
      <name xml:lang="ru">Назначение</name>
      <documentation xml:lang="ru">Администратор исполняет роль администратора безопасности.</documentation>
    </relationship>
    <relationship identifier="id-rel-04" source="id-elem-br-operator" target="id-elem-bp-initiation" xsi:type="Assignment">
      <name xml:lang="ru">Выполняет</name>
      <documentation xml:lang="ru">Оператор ведет стадию инициации.</documentation>
    </relationship>
    <relationship identifier="id-rel-05" source="id-elem-br-operator" target="id-elem-bp-contracting" xsi:type="Assignment">
      <name xml:lang="ru">Выполняет</name>
      <documentation xml:lang="ru">Оператор ведет договорную кампанию.</documentation>
    </relationship>
    <relationship identifier="id-rel-06" source="id-elem-br-operator" target="id-elem-bp-transfer" xsi:type="Assignment">
      <name xml:lang="ru">Выполняет</name>
      <documentation xml:lang="ru">Оператор организует передачу материалов и ПО.</documentation>
    </relationship>
    <relationship identifier="id-rel-07" source="id-elem-br-curator" target="id-elem-bp-analytics" xsi:type="Assignment">
      <name xml:lang="ru">Контролирует</name>
      <documentation xml:lang="ru">Куратор анализирует сводные отчеты.</documentation>
    </relationship>
    <relationship identifier="id-rel-08" source="id-elem-br-secadmin" target="id-elem-bp-analytics" xsi:type="Assignment">
      <name xml:lang="ru">Администрирует</name>
      <documentation xml:lang="ru">Администратор аудирует действия пользователей.</documentation>
    </relationship>
    <relationship identifier="id-rel-09" source="id-elem-bp-initiation" target="id-elem-bp-contracting" xsi:type="Triggering">
      <name xml:lang="ru">Переход к договорам</name>
      <documentation xml:lang="ru">Успешная встреча инициирует оформление договоров.</documentation>
    </relationship>
    <relationship identifier="id-rel-10" source="id-elem-bp-contracting" target="id-elem-bp-transfer" xsi:type="Triggering">
      <name xml:lang="ru">Переход к внедрению</name>
      <documentation xml:lang="ru">Подписание договора и лицензии открывает передачу материалов.</documentation>
    </relationship>
    <relationship identifier="id-rel-11" source="id-elem-bp-transfer" target="id-elem-bp-study" xsi:type="Triggering">
      <name xml:lang="ru">Запуск обучения</name>
      <documentation xml:lang="ru">Передача материалов и обучение педагогов активирует занятия.</documentation>
    </relationship>
    <relationship identifier="id-rel-12" source="id-elem-bc-partnership" target="id-elem-ba-manager" xsi:type="Aggregation">
      <name xml:lang="ru">Участник</name>
      <documentation xml:lang="ru">Ростелеком представлен менеджером.</documentation>
    </relationship>
    <relationship identifier="id-rel-13" source="id-elem-bc-partnership" target="id-elem-ba-unirep" xsi:type="Aggregation">
      <name xml:lang="ru">Участник</name>
      <documentation xml:lang="ru">Вуз представлен контактным лицом.</documentation>
    </relationship>
    <relationship identifier="id-rel-14" source="id-elem-bp-initiation" target="id-elem-bo-interaction" xsi:type="Access">
