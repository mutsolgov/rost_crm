{
  "realm": "rtk-crm",
  "enabled": true,
  "displayName": "ИТ Школа · Партнёры — тестовый стенд",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {"name": "manager", "description": "Менеджер: назначенные взаимодействия"},
      {"name": "supervisor", "description": "Руководитель: команда north"},
      {"name": "administrator", "description": "Администратор: без автоматического доступа к бизнес-данным"}
    ]
  },
  "clients": [
    {
      "clientId": "rtk-crm-web",
      "name": "RTK CRM local browser client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/##http://localhost:5173/"
      },
      "defaultClientScopes": ["profile", "email"],
      "protocolMappers": [
        {
          "name": "crm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rtk-crm-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "crm-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "manager-a",
      "enabled": true,
      "email": "manager-a@example.invalid",
      "emailVerified": true,
      "firstName": "Анна",
      "lastName": "Смирнова",
      "requiredActions": [],
      "realmRoles": ["manager"],
      "credentials": [{"type": "password", "value": "${DEMO_MANAGER_A_PASSWORD}", "temporary": false}]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "manager-b",
      "enabled": true,
      "email": "manager-b@example.invalid",
      "emailVerified": true,
      "firstName": "Михаил",
      "lastName": "Волков",
      "requiredActions": [],
      "realmRoles": ["manager"],
      "credentials": [{"type": "password", "value": "${DEMO_MANAGER_B_PASSWORD}", "temporary": false}]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "supervisor",
      "enabled": true,
      "email": "supervisor@example.invalid",
      "emailVerified": true,
      "firstName": "Елена",
      "lastName": "Соколова",
      "requiredActions": [],
      "realmRoles": ["supervisor"],
      "credentials": [{"type": "password", "value": "${DEMO_SUPERVISOR_PASSWORD}", "temporary": false}]
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "username": "administrator",
      "enabled": true,
      "email": "administrator@example.invalid",
      "emailVerified": true,
      "firstName": "Администратор",
      "lastName": "Демонстрационный",
      "requiredActions": [],
      "realmRoles": ["administrator"],
      "credentials": [{"type": "password", "value": "${DEMO_ADMINISTRATOR_PASSWORD}", "temporary": false}]
    }
  ]
}
