# DEVELOPMENT / SYNTHETIC DATA ONLY. Copy to .env; never commit the resulting file.
# These intentionally recognizable examples are not production secrets.
# Use URL-safe characters [A-Za-z0-9_-] for CRM_DB_PASSWORD in this compose DSN.
# Change these values before first initialization; existing DB/realm passwords
# are not changed by editing .env later.
POSTGRES_ADMIN_PASSWORD=dev_only_postgres_change_me
CRM_DB_PASSWORD=dev_only_crm_change_me
KEYCLOAK_DB_PASSWORD=dev_only_keycloak_db_change_me
KEYCLOAK_ADMIN_USER=local-admin
KEYCLOAK_ADMIN_PASSWORD=dev_only_keycloak_admin_change_me
KEYCLOAK_PUBLIC_URL=http://localhost:8080
DEMO_MANAGER_A_PASSWORD=ManagerPass123!
DEMO_MANAGER_B_PASSWORD=ManagerPass123!
DEMO_SUPERVISOR_PASSWORD=SupervisorPass123!
DEMO_ADMINISTRATOR_PASSWORD=AdminPass123!

# Optional backend configuration (defaults shown)
APP_ENV=development
AUTH_MODE=oidc
STORAGE_DIR=storage
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ENABLED=false
CLAMAV_TIMEOUT=10.0

# ==============================================================================
# Внешние интеграции и Zero-Code Switchover (LMS Zion & Web Portal)
# ==============================================================================
# Архитектура CRM поддерживает мгновенное бесшовное переключение между тремя
# режимами работы исключительно через переменные окружения (без изменения кода):
#
# ------------------------------------------------------------------------------
# РЕЖИМ 1: Mock Containers (Dev / Demo на реальных данных хакатона)
# Запуск контейнеров: docker compose -f mock_services/docker-compose.mock.yaml up -d --build
# CRM опрашивает локальные сервисы на портах 8081 и 8082 с полным циклом Reconciliation Inbox.
#
# LMS_INTEGRATION_MODE=live
# LMS_BASE_URL=http://127.0.0.1:8081
# LMS_API_TOKEN=mock-lms-token
# LMS_WEBHOOK_SECRET=rtk-lms-webhook-secret
# WEBSITE_INTEGRATION_MODE=live
# WEBSITE_BASE_URL=http://127.0.0.1:8082
# WEBSITE_API_TOKEN=mock-website-token
# WEBSITE_WEBHOOK_SECRET=rtk-website-webhook-secret
#
# ------------------------------------------------------------------------------
# РЕЖИМ 2: Production Live Systems (Боевые серверы организаторов)
# Подключение к реальным внешним порталам с авторизацией по токенам:
#
# LMS_INTEGRATION_MODE=live
# LMS_BASE_URL=https://lms.rt.ru/api
# LMS_API_TOKEN=<production_lms_bearer_token>
# LMS_WEBHOOK_SECRET=<production_lms_webhook_secret>
# WEBSITE_INTEGRATION_MODE=live
# WEBSITE_BASE_URL=https://portal.rt.ru/api
# WEBSITE_API_TOKEN=<production_website_bearer_token>
# WEBSITE_WEBHOOK_SECRET=<production_website_webhook_secret>
#
# ------------------------------------------------------------------------------
# РЕЖИМ 3: Offline / Mock File Mode (Полностью автономный / синтетический режим)
# Использует встроенные in-memory адаптеры без исходящих сетевых вызовов:
#
# LMS_INTEGRATION_MODE=mock
# WEBSITE_INTEGRATION_MODE=mock
# LMS_BASE_URL=https://rtkb.zion-lms.ru
# WEBSITE_BASE_URL=https://it-school.rt.ru
# ------------------------------------------------------------------------------
#
# Активная конфигурация (Zero-Code Switchover для локальных мок-контейнеров):
LMS_INTEGRATION_MODE=live
LMS_BASE_URL=http://127.0.0.1:8081
LMS_API_TOKEN=mock-lms-token
LMS_WEBHOOK_SECRET=rtk-lms-webhook-secret
WEBSITE_INTEGRATION_MODE=live
WEBSITE_BASE_URL=http://127.0.0.1:8082
WEBSITE_API_TOKEN=mock-website-token
WEBSITE_WEBHOOK_SECRET=rtk-website-webhook-secret
